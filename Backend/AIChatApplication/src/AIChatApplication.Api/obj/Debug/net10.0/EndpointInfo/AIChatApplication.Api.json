{
  "openapi": "3.1.1",
  "info": {
    "title": "AIChatApplication.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:61407"
    },
    {
      "url": "http://localhost:61408"
    }
  ],
  "paths": {
