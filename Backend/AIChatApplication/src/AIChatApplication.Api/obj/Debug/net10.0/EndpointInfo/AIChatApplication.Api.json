              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            }
          }
        }
      }
    }
